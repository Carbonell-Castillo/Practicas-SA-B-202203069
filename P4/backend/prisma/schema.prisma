generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CLIENT
}

model User {
  id              String   @id @default(uuid())
  nameEncrypted   String
  emailEncrypted  String
  emailHash       String   @unique
  passwordHash    String
  role            Role     @default(CLIENT)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("users")
}
