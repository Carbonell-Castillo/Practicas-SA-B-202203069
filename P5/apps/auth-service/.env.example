PORT=4000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public

JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=300
JWT_RENEWAL_GRACE_SECONDS=600

JWT_COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

AES_KEY=

AUTHORIZATION_SERVICE_URL=http://localhost:4001/api
AUTHORIZATION_TIMEOUT_MS=2000
AUTHORIZATION_MAX_RETRIES=3
AUTHORIZATION_BACKOFF_MS=500

# Usados solo por "npm run seed" para crear el primer usuario Admin.
# El registro público (/auth/register) siempre crea usuarios con rol CLIENT.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CambiaEstaClave123
ADMIN_NAME=Administrador