# Copia este archivo como ".env.test" y ajusta los valores si lo necesitas.
# NUNCA subas el archivo ".env.test" real al repositorio.
#
# Apunta a una base de datos COMPLETAMENTE distinta de la de desarrollo
# (contenedor, puerto y credenciales propios en docker-compose.yml, servicio
# "postgres-test"), para que las pruebas e2e nunca puedan tocar datos reales.

POSTGRES_TEST_USER=solicitudes_test_user
POSTGRES_TEST_PASSWORD=changeme_test
POSTGRES_TEST_DB=solicitudes_test_db
POSTGRES_TEST_HOST=localhost
POSTGRES_TEST_PORT=5433

# Debe contener la palabra "test": test/setup-env.ts lo verifica en cada
# arranque de la suite e2e y aborta si no la contiene.
DATABASE_URL="postgresql://solicitudes_test_user:changeme_test@localhost:5433/solicitudes_test_db?schema=public"
